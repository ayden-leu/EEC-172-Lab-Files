// builds and sends an HTTP POST message
static int http_post(int iTLSSockID)
{
    char acSendBuff[1024];
    char acRecvbuff[1460];
    char cCLLength[16];
    char *pcBufHeaders = acSendBuff;
    int lRetVal;

    int dataLength = (int)strlen(DATA1);
    sprintf(cCLLength, "%d", dataLength);

    //Build the HTTP request
    strcpy(pcBufHeaders, POSTHEADER);
    pcBufHeaders += strlen(POSTHEADER);

    strcpy(pcBufHeaders, HOSTHEADER);
    pcBufHeaders += strlen(HOSTHEADER);

    strcpy(pcBufHeaders, CHEADER);
    pcBufHeaders += strlen(CHEADER);

    // POST-specific headers
    strcpy(pcBufHeaders, CTHEADER);
    pcBufHeaders += strlen(CTHEADER);

    strcpy(pcBufHeaders, CLHEADER1);
    pcBufHeaders += strlen(CLHEADER1);

    strcpy(pcBufHeaders, cCLLength);
    pcBufHeaders += strlen(cCLLength);

    strcpy(pcBufHeaders, CLHEADER2);   // "\r\n\r\n"
    pcBufHeaders += strlen(CLHEADER2);

    // Body
    strcpy(pcBufHeaders, DATA1);
    pcBufHeaders += strlen(DATA1);

    // Debug print (safe)
    UART_PRINT("%s\r\n", acSendBuff);

    // Send
    lRetVal = sl_Send(iTLSSockID, acSendBuff, (int)strlen(acSendBuff), 0);
    if (lRetVal < 0) {
        UART_PRINT("POST failed. Error Number: %d\r\n", lRetVal);
        sl_Close(iTLSSockID);
        GPIO_IF_LedOn(MCU_RED_LED_GPIO);
        return lRetVal;
    }

    // Receive
    lRetVal = sl_Recv(iTLSSockID, acRecvbuff, sizeof(acRecvbuff) - 1, 0);
    if (lRetVal < 0) {
        UART_PRINT("Receive failed. Error Number: %d\r\n", lRetVal);
        GPIO_IF_LedOn(MCU_RED_LED_GPIO);
        return lRetVal;
    }

    // Null-terminate correctly
    acRecvbuff[lRetVal] = '\0';
    UART_PRINT("%s\r\n", acRecvbuff);

    return 0;
}

// builds and sends an HTTP GET message
static int http_get(int iTLSSockID)
{
    char acSendBuff[512];
    char acRecvbuff[1460];
    char *pcBufHeaders = acSendBuff;
    int lRetVal;

    strcpy(pcBufHeaders, GETHEADER);
    pcBufHeaders += strlen(GETHEADER);

    strcpy(pcBufHeaders, HOSTHEADER);
    pcBufHeaders += strlen(HOSTHEADER);

    strcpy(pcBufHeaders, CHEADER);
    pcBufHeaders += strlen(CHEADER);

    // End headers
    strcpy(pcBufHeaders, "\r\n");
    pcBufHeaders += 2;

    UART_PRINT("%s\r\n", acSendBuff);

    lRetVal = sl_Send(iTLSSockID, acSendBuff, (int)strlen(acSendBuff), 0);
    if (lRetVal < 0) {
        UART_PRINT("GET failed. Error Number: %d\r\n", lRetVal);
        sl_Close(iTLSSockID);
        GPIO_IF_LedOn(MCU_RED_LED_GPIO);
        return lRetVal;
    }

    lRetVal = sl_Recv(iTLSSockID, acRecvbuff, sizeof(acRecvbuff) - 1, 0);
    if (lRetVal < 0) {
        UART_PRINT("Receive failed. Error Number: %d\r\n", lRetVal);
        GPIO_IF_LedOn(MCU_RED_LED_GPIO);
        return lRetVal;
    }

    acRecvbuff[lRetVal] = '\0';
    UART_PRINT("%s\r\n", acRecvbuff);
    return 0;
}
